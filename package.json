{
  "name": "luxfatum-online-v5",
  "version": "5.0.0",
  "private": true,
  "description": "LuxFatum v5.0.0 GitHub Render and App release",
  "scripts": {
    "start": "node server.js",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check": "node --check server.js",
    "validate:domain": "node scripts/validate-domain-model.mjs",
    "version:show": "node scripts/show-version.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "package:release": "npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "pixi.js": "^8.18.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
